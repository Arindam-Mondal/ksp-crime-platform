# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Catalyst CLI artifacts ---
.catalyst/
catalyst-cli.log
**/.catalyst-deploy/

# --- Generated data (keep the folder, not the CSVs) ---
data/output/*
