# Copy to .env and fill in. .env is gitignored.

# Backend data source: "local" reads data/output/*.csv; "catalyst" uses the Data Store SDK.
DATA_MODE=local
DATA_DIR=../data/output

# Catalyst (only needed when DATA_MODE=catalyst / deployed)
CATALYST_PROJECT_ID=
CATALYST_ENVIRONMENT=development

# QuickML LLM Serving + RAG (early-access). All LLM calls go through backend/app/services/llm.py.
# Leave LLM_PROVIDER=mock for local dev so no credits are spent.
LLM_PROVIDER=mock
QUICKML_ENDPOINT=
QUICKML_API_KEY=
QUICKML_MODEL=qwen2.5-14b-instruct
