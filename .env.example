# Copy to .env and fill in. .env is gitignored.

# --- Backend (AppSail) ---
# Data source: "local" reads the bundled CSVs (DATA_DIR); "catalyst" reads the Data Store.
#   Phase 1 (prove the deploy): local. Phase 2 (after seeding Data Store + running the
#   Cron jobs): catalyst.
DATA_MODE=local
DATA_DIR=../data/output

# Catalyst (only needed when DATA_MODE=catalyst / deployed)
CATALYST_PROJECT_ID=
CATALYST_ENVIRONMENT=development

# QuickML LLM Serving (GLM-4.7-Flash — Qwen 2.5-14B was deprecated, cutover 2026-07-31).
# All LLM calls go through backend/app/services/llm.py.
# Leave LLM_PROVIDER=mock for local dev / first deploy so no credits are spent.
# To go live with the real model: LLM_PROVIDER=quickml + the values below. Steps (confirmed
# from the QuickML console's own "Sample Request and Response" tab — see llm.py for the
# full contract):
#   1. console.catalyst.zoho.com -> your project -> QuickML -> enable if gated.
#   2. QuickML -> Generative AI -> LLM Serving -> Models -> GLM-4.7-Flash -> deploy.
#   3. Endpoints -> open the GLM-4.7-Flash chat endpoint -> "Model Details" tab:
#      QUICKML_ENDPOINT = the Endpoint URL shown there (project id is baked into the path,
#      e.g. https://api.catalyst.zoho.in/quickml/v1/project/<id>/glm/chat).
#      No endpoint key needed for this endpoint type.
#   4. QUICKML_ORG_ID = the CATALYST-ORG value shown in the endpoint's Headers box (also
#      your project's org id, Catalyst console -> project settings). NOTE: named
#      QUICKML_ORG_ID not CATALYST_ORG_ID — the AppSail console rejects CATALYST_ORG_ID
#      as a reserved key (Catalyst auto-injects its own env vars with that name pattern).
#   5. Auth (preferred — never goes stale): api-console.zoho.com -> Self Client ->
#      "Generate Code" (scope QuickML.deployment.READ) -> exchange that code ONCE for an
#      access_token + refresh_token (POST https://accounts.zoho.in/oauth/v2/token,
#      grant_type=authorization_code) -> set QUICKML_CLIENT_ID/SECRET (from the "Client
#      Secret" tab) + QUICKML_REFRESH_TOKEN (from the exchange response) below. The app
#      auto-mints fresh hourly access tokens from these from then on.
LLM_PROVIDER=mock
QUICKML_ENDPOINT=
QUICKML_ORG_ID=
QUICKML_MODEL=crm-di-glm47b_30b_it
QUICKML_CLIENT_ID=
QUICKML_CLIENT_SECRET=
QUICKML_REFRESH_TOKEN=
# Fallback only — a directly-pasted access token, expires in 1hr. Leave blank once the
# refresh-token trio above is set.
QUICKML_OAUTH_TOKEN=

# Report PDF (optional; catalyst mode → SmartBrowz HTML→PDF in Stratus).
# Leave blank to use the browser's print-to-PDF (works everywhere, no credits).
SMARTBROWZ_ENDPOINT=
SMARTBROWZ_API_KEY=
STRATUS_BUCKET=

# --- Frontend (Slate / Web Client Hosting) ---
# Build-time only (Vite). Leave UNSET for local dev (Vite proxies /api to :9000).
# In production set it to the deployed API origin so the SPA can reach AppSail, e.g.
#   VITE_API_BASE=https://<project>.development.catalystserverless.com
# Put this in frontend/.env.production (NOT here) before `npm run build`.
# VITE_API_BASE=
