# Copy to frontend/.env.production and set the deployed API origin, then `npm run build`.
# This is baked into the SPA at build time so the hosted frontend can reach the AppSail API.
# Find the value after deploying the backend (catalyst appsail:deploy prints the URL),
# or use your API Gateway URL.
VITE_API_BASE=https://<your-project>.development.catalystserverless.com
